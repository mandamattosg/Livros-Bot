# --- Projeto ---
PROJECT_NAME=Book Price Bot
DEBUG=false
LOG_LEVEL=INFO

# --- Banco de dados ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/book_price_bot

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID do usuário administrador e chat que recebe alertas/relatórios
ADMIN_TELEGRAM_ID=
ADMIN_ALERT_CHAT_ID=
ADMIN_ALERTS_ENABLED=true

# --- Amazon Creators API ---
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Opcional: token fixo; se vazio, o token é obtido via OAuth e guardado em cache
AMAZON_ACCESS_TOKEN=
AMAZON_TOKEN_CACHE_FILE=.amazon_oauth_cache.json
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# --- Regras de negócio ---
PRICE_DROP_MINIMUM=4
PRICE_DROP_MINIMUM_PERCENTAGE=10
USER_PRODUCT_MONITOR_LIMIT=10

# --- Intervalos de atualização de preço ---
REFRESH_HIGH_MONITOR_MIN_USERS=3
REFRESH_HIGH_MONITOR_INTERVAL_HOURS=6
REFRESH_LOW_MONITOR_INTERVAL_HOURS=12
REFRESH_INTERVAL_TOLERANCE_MINUTES=15

# --- Worker de monitoramento ---
# once = processa uma vez e sai; forever = roda continuamente
MONITORING_WORKER_MODE=forever
MONITORING_WORKER_BATCH_SIZE=10
MONITORING_WORKER_MAX_RETRIES=3
MONITORING_WORKER_POLL_INTERVAL=2.0
MONITORING_WORKER_BATCH_SLEEP=0.5
MONITORING_WORKER_LOCK_TTL=60
MONITORING_WORKER_STUCK_MINUTES=10

# --- Worker de notificações ---
NOTIFICATION_WORKER_MODE=forever
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_MAX_RETRIES=5
NOTIFICATION_WORKER_POLL_INTERVAL=1.5
NOTIFICATION_WORKER_BATCH_SLEEP=0.6
NOTIFICATION_WORKER_LOCK_TTL=60
NOTIFICATION_WORKER_STUCK_MINUTES=10
